{
  "name": "js-portable-queue-lan",
  "version": "0.1.0",
  "description": "LAN-based queueing appliance (Express + Socket.IO + SQLite backend for JS-Portable-Queue)",
  "author": "paoradox",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "electron": "electron .",
    "dist": "electron-builder --win --dir",
    "dist:linux": "electron-builder --linux --dir"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.4"
  },
  "build": {
    "appId": "com.paoradox.jsportablequeuelan",
    "productName": "Portable Queue",
    "executableName": "Portable Queue",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "frontend/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  }
}
